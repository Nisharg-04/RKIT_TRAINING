<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="true"
      internalLogLevel="Trace"
      internalLogFile="logs/nlog-special-internal.log">

	<targets>
		<target xsi:type="File"
				name="auditFile"
				fileName="logs/audit-${shortdate}.log"
				createDirs="true"
				layout="${longdate}|AUDIT|${message}" />
	</targets>

	<rules>
		<logger name="*"
				minlevel="Trace"
				writeTo="auditFile" />
	</rules>

</nlog>
